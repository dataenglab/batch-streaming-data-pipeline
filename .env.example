# Скопируй в .env: cp .env.example .env  и заполни значения.
# Файл .env в git не попадает.

# Superset: любая длинная случайная строка
SUPERSET_SECRET_KEY=change_me_to_long_random_string

# Airflow: ключ шифрования (32 байта в url-safe base64). Сгенерировать в Git Bash / Linux / macOS:
#   openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
